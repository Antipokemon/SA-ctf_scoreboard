<dashboard version="1.1" script="ctf_event_context.js,welcome.js" hideEdit="true" theme="dark">
  <label>Capture the Flag</label>
  <row>
    <panel>
      <html>
        <div id="ctf-context-error" style="display:none; padding:12px; margin-bottom:16px; border:1px solid #d9534f;"></div>

        <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:30px;">
          <div style="flex:1;">
            <h1>Welcome to the Capture the Flag (CTF) Competition</h1>
            <p>You'll be presented with realistic scenarios, and you will earn points by answering questions of varying difficulty.</p>

            <h2>Your Event Details</h2>
            <table class="table table-bordered" style="width:auto; min-width:420px;">
              <tbody>
                <tr><td><strong>CTF Event</strong></td><td><strong>$ctf_event_name$</strong></td></tr>
                <tr><td><strong>Splunk User</strong></td><td><strong>$env:user$</strong></td></tr>
                <tr><td>Display Username</td><td><strong>$ctf_DisplayUsername$</strong></td></tr>
                <tr><td>Team</td><td><strong>$ctf_Team$</strong></td></tr>
                <tr><td>Search Server URL</td><td><a href="$ctf_SearchUrl$" target="_blank" rel="noopener noreferrer">$ctf_SearchUrl$</a></td></tr>
                <tr><td>Event State</td><td><strong>$ctf_event_state$</strong></td></tr>
                <tr><td>Registration State</td><td><strong>$ctf_registration_state$</strong></td></tr>
                <tr><td>Stealth Mode</td><td><strong>$ctf_stealth_mode$</strong></td></tr>
                <tr><td>User Agreement</td><td><strong>$ctf_agreement_accepted$</strong></td></tr>
              </tbody>
            </table>
          </div>

          <div style="width:320px; text-align:center;">
            <img src="$ctf_image_url$" alt="$ctf_event_name$"
                 style="max-width:300px; max-height:300px; width:100%; object-fit:contain;"/>
          </div>
        </div>

        <div style="display:flex; gap:80px; margin-top:24px;">
          <div>
            <h2>User Agreement</h2>
            <button id="agreement_modal_button" type="button" class="btn btn-primary">View/Accept</button>
          </div>
          <div>
            <h2>Stealth Mode</h2>
            <button id="enable_stealth_button" type="button" class="btn btn-primary">Enable</button>
            <button id="disable_stealth_button" type="button" class="btn btn-primary">Disable</button>
          </div>
        </div>

        <div style="margin-top:40px;">
  <h2>Important resources</h2>

  <ul>
    <li>
      <a href="questions?ctf_id=$ctf_id$">Questions</a>:
      Submit answers and review your team's previous responses.
    </li>

    <li>
      <a href="top_10_teams?ctf_id=$ctf_id$">Top 10 Teams</a>:
      Current top ten teams.
    </li>

    <li>
      <a href="AllScores?ctf_id=$ctf_id$">All Teams' Scores</a>:
      All team scores.
    </li>

    <li>
      <a href="event_activity?ctf_id=$ctf_id$">Event Activity</a>:
      Current event activity.
    </li>

    <li>
      <a href="rules?ctf_id=$ctf_id$">Rules</a>:
      Competition rules.
    </li>

    <li>
      Help Menu: Scenarios and other resources that will help you throughout the competition.
    </li>
  </ul>
</div>
      </html>
    </panel>
  </row>
</dashboard>
