<dashboard version="1.1"
           script="ctf_event_context.js,instantiate_countdown.js,challenge_grid.js"
           stylesheet="questions.css,table_decorations.css"
           hideEdit="true"
           theme="dark">

  <label>Challenges</label>

  <search id="challengeData">
    <query>
| inputlookup ctf_questions
| search ctf_id="$ctf_id$"
| eval Category=coalesce(Category,"Challenges")
| eval ChallengeID=coalesce(ChallengeID,printf("Q%03d",Number))
| fields Number Question BasePoints Category ChallengeID
| join type=left Number
    [ search index=scoreboard
             ctf_id="$ctf_id$"
             Team="$ctf_Team$"
             (Result="Incorrect" OR Result="Correct" OR Result="Bonus" OR Result="Hint")
      | stats count(eval(Result=="Incorrect" OR Result=="Correct")) as Attempts
              count(eval(Result=="Incorrect")) as IncorrectAttempts
              count(eval(Result=="Correct")) as CorrectAttempts
              max(BasePointsAwarded) as BasePointsAwarded
              max(SpeedBonusAwarded) as SpeedBonusAwarded
              max(AdditionalBonusAwarded) as AdditionalBonusAwarded
              sum(Penalty) as Penalty
        by Number
      | fillnull value=0 BasePointsAwarded SpeedBonusAwarded AdditionalBonusAwarded Penalty
      | eval QuestionScore=BasePointsAwarded+SpeedBonusAwarded+AdditionalBonusAwarded-Penalty
    ]
| fillnull value=0 Attempts IncorrectAttempts CorrectAttempts BasePoints QuestionScore
| eval Status=case(
        CorrectAttempts&gt;0,"Correct",
        IncorrectAttempts&gt;0,"Incorrect",
        true(),"Unanswered"
  )
| fields Number ChallengeID Category Question Status BasePoints Attempts IncorrectAttempts CorrectAttempts QuestionScore
| sort 0 + Number
    </query>
    <earliest>0</earliest>
    <latest>now</latest>
    <refresh>5s</refresh>
    <refreshType>delay</refreshType>
  </search>

  <row id="ctf_overview_row">
    <panel id="ctf_logo_panel">
      <html>
        <div id="ctf-context-error" class="ctf-error" style="display:none;"></div>
        <div class="ctf-logo-wrap">
          <img id="ctflogo" src="/static/app/SA-ctf_scoreboard/ctflogo.png"/>
        </div>
      </html>
    </panel>

    <panel id="ctf_info_panel">
      <html>
        <div class="ctf-info-card">
          <div class="ctf-kicker">CTF EVENT</div>
          <div class="ctf-event-name">$ctf_event_name$</div>
          <div class="ctf-meta-grid">
            <div><span>User</span><strong>$ctf_DisplayUsername$</strong></div>
            <div><span>Team</span><strong>$ctf_Team$</strong></div>
          </div>
        </div>
      </html>
    </panel>

    <panel id="ctf_time_panel">
      <html>
        <div class="ctf-time-card">
          <div class="ctf-kicker">TIME REMAINING</div>
          <div id="clock"></div>
          <div id="clock-text">Days : Hours : Minutes : Seconds</div>
        </div>
      </html>
    </panel>
  </row>

  <row id="ctf_progress_row">
    <panel>
      <html>
        <div class="ctf-progress-grid">
          <div class="ctf-progress-card">
            <span>Completed</span>
            <strong id="ctf_progress_completed_value">0</strong>
            <small>questions solved</small>
          </div>
          <div class="ctf-progress-card">
            <span>Remaining</span>
            <strong id="ctf_progress_remaining_value">0</strong>
            <small>questions open</small>
          </div>
          <div class="ctf-progress-card">
            <span>Team Score</span>
            <strong id="ctf_team_score_value">0</strong>
            <small>points earned</small>
          </div>
        </div>
      </html>
    </panel>
  </row>

  <row id="ctf_challenges_row">
    <panel>
      <html>
        <div class="ctf-challenge-toolbar">
          <div class="ctf-filter-group" role="group" aria-label="Challenge status filter">
            <button type="button" class="ctf-filter is-active" data-filter="all">All</button>
            <button type="button" class="ctf-filter" data-filter="open">Open</button>
            <button type="button" class="ctf-filter" data-filter="solved">Solved</button>
            <button type="button" class="ctf-filter" data-filter="incorrect">Attempted</button>
          </div>
          <input id="ctf_challenge_search" class="ctf-challenge-search" type="search" placeholder="Search challenges" aria-label="Search challenges"/>
          <div id="ctf_live_status" class="ctf-live-status">Team status refreshes every 5 seconds</div>
        </div>

        <div id="ctf_challenge_sections" class="ctf-challenge-sections"></div>
        <div id="ctf_challenge_empty" class="ctf-challenge-empty" style="display:none;">No challenges match this filter.</div>

        <div id="ctf_team_toast" class="ctf-team-toast" role="status" aria-live="polite"></div>

        <div id="ctf_challenge_modal" class="ctf-modal" aria-hidden="true">
          <div class="ctf-modal-backdrop" data-modal-close="1"></div>
          <div class="ctf-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="ctf_modal_title">
            <button type="button" class="ctf-modal-close" data-modal-close="1" aria-label="Close challenge">&#215;</button>

            <div class="ctf-modal-topline">
              <span id="ctf_modal_challenge_id" class="ctf-challenge-id"></span>
              <span id="ctf_modal_status" class="ctf-status-badge"></span>
            </div>

            <h2 id="ctf_modal_title" class="ctf-modal-title"></h2>

            <div class="ctf-modal-stats">
              <div><span>Points</span><strong id="ctf_modal_points">0</strong></div>
              <div><span>Team attempts</span><strong id="ctf_modal_attempts">0</strong></div>
            </div>

            <div id="ctf_modal_message" class="ctf-modal-message" style="display:none;"></div>

            <form id="ctf_answer_form" class="ctf-modal-answer-form">
              <label for="ctf_answer_input">Answer</label>
              <div class="ctf-modal-answer-row">
                <input id="ctf_answer_input" name="Answer" type="text" autocomplete="off" placeholder="Enter answer"/>
                <button id="ctf_answer_submit" type="submit" class="btn btn-primary">Submit</button>
              </div>
              <div class="ctf-answer-help">Answers are case-insensitive; leading and trailing whitespace is ignored.</div>
            </form>

            <section class="ctf-modal-hints">
              <h3>Hints</h3>
              <div id="ctf_modal_hints_loading" class="ctf-hint-loading">Loading hints…</div>
              <div id="ctf_modal_hints" class="ctf-hint-list"></div>
            </section>
          </div>
        </div>
      </html>
    </panel>
  </row>

</dashboard>
